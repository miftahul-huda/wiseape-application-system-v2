PORT=3000

# All API traffic goes through the Kong gateway (http://localhost:8000):
#   /was     -> WAS API            (server/applications/WiseapeApplicationSystem, :4000)
#   /hris    -> HRIS API           (server/applications/HRIS, :4001)
#   /report  -> Report Designer API (server/applications/ReportDesigner, :4002)
#   /desktop -> this client's Express server (:3000), used by the Vite dev proxy
# Base URL of the WAS API (no trailing /api -- the repositories add /api/...):
API_BASE_URL=http://localhost:8000/was
# Base URL of this client's Express server, used by `npm run dev:web` (Vite proxy):
WAS_SERVER_URL=http://localhost:8000/desktop
# Optional overrides for the browser-run apps' defaults:
# HRIS_API_URL=http://localhost:8000/hris/api
# REPORT_DESIGNER_API_URL=http://localhost:8000/report/api
