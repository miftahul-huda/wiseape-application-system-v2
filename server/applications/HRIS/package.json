{
  "name": "wiseape-hris-server",
  "version": "1.0.0",
  "description": "Wiseape HRIS Microservice REST API Backend using Node.js, Express, Sequelize, and PostgreSQL",
  "main": "app.js",
  "scripts": {
    "start": "node --env-file=.env app.js",
    "dev": "node --watch --env-file=.env app.js",
    "seed": "node --env-file=.env src/scripts/seed.js",
    "sync": "node --env-file=.env src/scripts/syncDb.js",
    "test": "node --env-file=.env src/scripts/testApi.js"
  },
  "keywords": [
    "wiseape",
    "hris",
    "microservice",
    "rest-api",
    "nodejs",
    "sequelize",
    "postgresql"
  ],
  "author": "Wiseape",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  }
}
